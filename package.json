{
  "name": "dreamtalk",
  "version": "0.1.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/api-client"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:web": "npm run build --workspace @dreamtalk/web",
    "dev:web": "npm run dev --workspace @dreamtalk/web -- --host 127.0.0.1 --port 1430",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:build": "pwsh -NoProfile -File scripts/build-android.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "pyright": "1.1.414",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
