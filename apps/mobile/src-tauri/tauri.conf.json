{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dreamtalk",
  "version": "0.1.3",
  "identifier": "app.livingworld.desktop",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run build:web",
      "cwd": "../../.."
    },
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dreamtalk",
        "width": 430,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*",
      "capabilities": [
        "mobile"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
